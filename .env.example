# Copiá a .env y completá tras provisionar en Vercel
PAYLOAD_SECRET=generar_con_openssl_rand_hex_32
# Postgres (Neon). Vercel lo inyecta como DATABASE_URL/POSTGRES_URL; para local pegá la connection string:
DATABASE_URI=postgresql://user:pass@host/db
# Token de Vercel Blob (para subir fotos en produccion):
BLOB_READ_WRITE_TOKEN=
